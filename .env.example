# Aegis Orchestrator — example environment configuration
# Copy to .env and fill in real values. Never commit the populated .env file.

# AEGIS_LAB_KEY is the path to a file containing the shared symmetric HMAC key
# used to verify machine authentication challenges. The file must hold a
# hex-encoded string that decodes to exactly 32 bytes (64 hex characters). The
# key is never transmitted to or presented by a machine, and must never be
# committed.
AEGIS_LAB_KEY=/etc/aegis/lab.key

# AEGIS_SESSION_SECRET is the HMAC signing secret used for issued session
# tokens. Required; must never be logged or committed.
AEGIS_SESSION_SECRET=change-me-to-a-long-random-secret

# AEGIS_SESSION_TTL overrides the lifetime of issued session tokens.
# Accepts Go duration strings (e.g. 30m, 1h, 24h). Defaults to 24h.
AEGIS_SESSION_TTL=24h

# AEGIS_STALENESS_GRACE overrides how long a machine remains displayed as
# CONNECTED after its last heartbeat. Accepts Go duration strings; must be
# positive and should exceed the fleet's heartbeat interval (Sentinels default
# to 30s). Defaults to 90s (3 x the default interval).
AEGIS_STALENESS_GRACE=90s

# Accepted machine sources are no longer configured here: POST an "ip,name,lab"
# CSV to /machines/import instead. Each machine listed is "certified" and may
# authenticate; a non-empty lab links it to the group of that name, creating
# the group when missing.

# AEGIS_GRPC_ADDR is the address the gRPC propagation server binds to.
# Defaults to :9090.
AEGIS_GRPC_ADDR=:9090
